<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground"
    android:paddingHorizontal="20dp"
    android:paddingTop="48dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/comfortaa_bold"
            android:text="Настройки"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.5"
        android:fontFamily="@font/comfortaa_bold"
        android:letterSpacing="0.1"
        android:text="ИНТЕРФЕЙС"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="?android:attr/textColorPrimary"
        app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/comfortaa_bold"
                    android:text="Вибрация"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:fontFamily="@font/comfortaa_bold"
                    android:text="Тактильный отклик в упражнениях"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchVibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.5"
        android:fontFamily="@font/comfortaa_bold"
        android:letterSpacing="0.1"
        android:text="ПРИОРИТЕТНОЕ ЗАЗЕМЛЕНИЕ"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="12sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="?android:attr/textColorPrimary"
        app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

        <RadioGroup
            android:id="@+id/rgGrounding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/rb54321"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/comfortaa_bold"
                android:text="Техника 5-4-3-2-1"
                android:buttonTint="?android:attr/textColorPrimary"
                android:paddingStart="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="?android:attr/textColorPrimary"
                android:alpha="0.1" />

            <RadioButton
                android:id="@+id/rbPMR"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/comfortaa_bold"
                android:text="Релаксация ПМР"
                android:buttonTint="?android:attr/textColorPrimary"
                android:paddingStart="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="?android:attr/textColorPrimary"
                android:alpha="0.1" />

            <RadioButton
                android:id="@+id/rbBreathe"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/comfortaa_bold"
                android:text="Квадратное дыхание"
                android:buttonTint="?android:attr/textColorPrimary"
                android:paddingStart="12dp" />
        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>