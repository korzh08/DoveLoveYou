<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 ПРЕДМЕТОВ"
            android:textSize="26sp"
            android:letterSpacing="0.05"
            android:fontFamily="@font/comfortaa_bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/tvStepHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Которые вы видите прямо сейчас"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:fontFamily="@font/comfortaa_bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center" />

        
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="?android:attr/textColorPrimary"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Что вы видите?"
                android:background="@android:color/transparent"
                android:padding="20dp"
                android:fontFamily="@font/comfortaa_bold"
                android:inputType="textCapSentences"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 5"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/comfortaa_bold"
            android:alpha="0.5"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"/>

        
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="?android:attr/textColorPrimary"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            android:clickable="true"
            android:focusable="true"
            app:rippleColor="?android:attr/textColorPrimary">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ДАЛЕЕ"
                android:textSize="16sp"
                android:letterSpacing="0.1"
                android:fontFamily="@font/comfortaa_bold"
                android:textColor="?android:attr/textColorPrimary" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    
    <View
        android:id="@+id/flashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/flash_color"
        android:alpha="0"
        android:visibility="gone" />

</FrameLayout>