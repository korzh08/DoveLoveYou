<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:attr/windowBackground">

    <!-- Заголовок -->
    <TextView
        android:id="@+id/tvInstructionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/comfortaa_bold"
        android:letterSpacing="0.1"
        android:text="ИНСТРУКЦИЯ EMDR"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Подробная инструкция -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/comfortaa_bold"
        android:lineSpacingExtra="6dp"
        android:text="ДПДГ (EMDR) помогает снизить интенсивность тревожных воспоминаний. \n\nСядьте ровно, держите голову неподвижно. Следите только глазами за движением точки из стороны в сторону. \n\nВыберите очень спокойный темп для начала:"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:alpha="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInstructionTitle" />

    <!-- Сетка скоростей через MaterialCardView -->
    <LinearLayout
        android:id="@+id/speedContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/tvInstruction">

        <!-- МЕДЛЕННО -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSlow"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="?android:attr/textColorPrimary"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/comfortaa_bold"
                android:text="МЕДЛЕННО\n(Режим 1)"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- СРЕДНЕ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMedium"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:layout_marginStart="4dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="?android:attr/textColorPrimary"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/comfortaa_bold"
                android:text="СРЕДНЕ\n(Режим 2)"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- БЫСТРО -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnFast"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="?android:attr/textColorPrimary"
            app:cardBackgroundColor="?android:attr/colorBackgroundFloating"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/card_press">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/comfortaa_bold"
                android:text="БЫСТРО\n(Режим 3)"
                android:gravity="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:alpha="0.5"
        android:fontFamily="@font/comfortaa_bold"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:text="ПОВЕРНИТЕ СМАРТФОН ГОРИЗОНТАЛЬНО"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>