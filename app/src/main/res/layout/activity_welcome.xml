<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:attr/windowBackground"
    tools:context=".WelcomeActivity">

    
    <TextView
        android:id="@+id/welcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/comfortaa_bold"
        android:text="Добро пожаловать"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="32sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/welcomeDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:alpha="0.7"
        android:fontFamily="@font/comfortaa_bold"
        android:text="Для начала давайте настроим основной метод помощи, который будет запускаться при нажатии кнопки SOS."
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeTitle" />

    
    <RadioGroup
        android:id="@+id/rgSosMethods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeDesc">

        <RadioButton
            android:id="@+id/rbBreathe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/comfortaa_bold"
            android:text="Квадратное дыхание"
            android:textSize="16sp"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rbPmrFull"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/comfortaa_bold"
            android:text="@string/pmr_full"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbPmrExpress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/comfortaa_bold"
            android:text="@string/pmr_express"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbGrounding"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/comfortaa_bold"
            android:text="Заземление 5-4-3-2-1"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbDescribe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="@font/comfortaa_bold"
            android:text="@string/describe_object_radio"
            android:textSize="16sp" />
    </RadioGroup>

    
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/comfortaa_bold"
            android:letterSpacing="0.1"
            android:text="ДАЛЕЕ"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>